# ─────────────────────────────────────────────────────────────────────────────
# Movie Memory — environment variables
#
#   cp .env.example .env      then fill in the values below.
#
# .env is git-ignored. None of these use the NEXT_PUBLIC_ prefix, so Next.js
# never bundles them into browser code — they are only read on the server.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database (required) ──────────────────────────────────────────────────────
# Postgres connection string used by the app and by Prisma migrations.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# The values below match the role/databases created in README §1, step 2.
DATABASE_URL="postgresql://moviememory:moviememory@localhost:5432/moviememory?schema=public"

# Separate database used ONLY by `pnpm test`. Tests delete all rows between
# cases, so this must NOT be your dev database — the test runner refuses to
# start if it equals DATABASE_URL. Migrations are applied to it automatically.
TEST_DATABASE_URL="postgresql://moviememory:moviememory@localhost:5432/moviememory_test?schema=public"


# ── Auth.js (required) ───────────────────────────────────────────────────────
# Secret used to encrypt the session cookie. Any long random string.
# Generate one with:   openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth client — Google Cloud Console → APIs & Services → Credentials
#   → Create credentials → OAuth client ID → "Web application"
#     Authorized JavaScript origin:  http://localhost:3000
#     Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
# While the OAuth consent screen is in "Testing", add your Google account under
# Test users, otherwise sign-in fails with "access_denied".
AUTH_GOOGLE_ID=""        # looks like: 1234567890-abc...apps.googleusercontent.com
AUTH_GOOGLE_SECRET=""    # looks like: GOCSPX-...


# ── OpenAI ───────────────────────────────────────────────────────────────────
# API key from https://platform.openai.com/api-keys  (looks like: sk-...)
# Required for fun facts. Without it the app still runs, and the fact card
# shows a friendly "couldn't come up with a fun fact" message.
OPENAI_API_KEY=""

# Optional. Model used for fact generation. Defaults to gpt-4o-mini if empty.
OPENAI_MODEL="gpt-4o-mini"

# Optional. Only for running the PRODUCTION build locally (pnpm build && pnpm start):
# Auth.js rejects unknown hosts in production ("UntrustedHost") unless this is true.
# Not needed for `pnpm dev`; set automatically on Vercel.
# AUTH_TRUST_HOST=true
